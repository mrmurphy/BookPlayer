<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Groups - supported on free/personal teams -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(CFBundleIdentifier).files</string>
	</array>
	<!-- Removed capabilities not supported on personal teams:
	     - Sign In with Apple (com.apple.developer.applesignin)
	     - iCloud (com.apple.developer.icloud-*)
	     - Siri (com.apple.developer.siri)
	     
	     Note: These features will not work in the app when using this entitlements file.
	     To use all features, you'll need a paid Apple Developer account ($99/year).
	-->
</dict>
</plist>
